# n8n Webhook Base URL
# Replace with your n8n instance URL when deploying
# Format: https://your-n8n-instance.com/webhook
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Optional: API Keys (if using direct API calls instead of n8n)
# VITE_OPENAI_API_KEY=your-openai-key
# VITE_STABILITY_API_KEY=your-stability-key
